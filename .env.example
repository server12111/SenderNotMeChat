BOT_TOKEN=123456:ABC
# ID админов через запятую
ADMIN_IDS=111111111,222222222
# https://my.telegram.org -> API development tools
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef
# Папка, которая сохраняется при перезапуске (база, ключ шифрования сессий, медиа).
# На хостинге — /app/data (по умолчанию), локально — ./data. Можно не задавать.
DATA_DIR=
# SQLite по умолчанию (файл bot.db внутри DATA_DIR); для PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=
# username поддержки для кнопок оплаты (без @)
SUPPORT_USERNAME=your_support
# сколько рассылок обрабатывается одновременно
MAX_RUNNING=20
# ключ шифрования сессий (Fernet). Если пусто — создаётся data/secret.key
ENCRYPTION_KEY=
